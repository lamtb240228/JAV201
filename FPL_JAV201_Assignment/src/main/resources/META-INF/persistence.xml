<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
  <persistence-unit name="FPL" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!-- Khai báo entity -->
    <class>entity.User</class>
    <class>entity.Favorite</class>
    <class>entity.Share</class>
    <class>entity.Video</class>

    <!-- Cấu hình kết nối MySQL -->
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:mysql://yeumedevs.space:3306/yeumeent_jav201_assignment?useSSL=false&amp;serverTimezone=UTC" />
      <property name="jakarta.persistence.jdbc.user" value="yeumeent_jav201" />
      <property name="jakarta.persistence.jdbc.password" value="JAV201@hehe123" />
      <!-- Dialect cho Hibernate 7 -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect" />

      <!-- Tùy chọn -->
      <property name="hibernate.hbm2ddl.auto" value="update" />
      <property name="hibernate.show_sql" value="true" />
      <property name="hibernate.format_sql" value="true" />
    </properties>
  </persistence-unit>
</persistence>