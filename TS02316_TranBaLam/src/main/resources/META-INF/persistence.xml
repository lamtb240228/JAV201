<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="BookStorePU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.bookstore.model.Category</class>
        <class>com.bookstore.model.Book</class>

        <properties>
            <!-- Kết nối MySQL -->
            <property name="jakarta.persistence.jdbc.driver"           value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"              value="jdbc:mysql://localhost:3306/bookstore?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true"/>
            <property name="jakarta.persistence.jdbc.user"             value="root"/>
            <property name="jakarta.persistence.jdbc.password"         value="1234"/> <!-- thay bằng mật khẩu thật của bạn -->

            <!-- Hibernate dialect cho MySQL 8 -->
            <property name="hibernate.dialect"                         value="org.hibernate.dialect.MySQLDialect"/>

            <!-- Tự động tạo/update bảng (dùng update khi phát triển, validate khi deploy) -->
            <property name="hibernate.hbm2ddl.auto"                    value="update"/>

            <!-- Hiện SQL ra console để debug -->
            <property name="hibernate.show_sql"                        value="true"/>
            <property name="hibernate.format_sql"                      value="true"/>

            <!-- Optional: tối ưu hóa -->
            <property name="hibernate.jdbc.time_zone"                  value="UTC"/>
        </properties>
    </persistence-unit>
</persistence>